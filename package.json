{
  "name": "ems-tool",
  "version": "1.0.0",
  "description": "Playwright + Edge CDP → SmartPiEMS 空调采集与数据管理",
  "scripts": {
    "enum": "node src/enumerate.js",
    "enum:dry": "node src/enumerate.js --dry",
    "enum:edge": "node src/enumerate.js --edge",
    "enum:edge:append": "node src/enumerate.js --edge --append",
    "enum:edge:dry": "node src/enumerate.js --edge --dry",
    "import": "node scripts/import.js",
    "validate": "node scripts/validate-enum.js",
    "quality": "node scripts/quality-report.js",
    "native:run": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-native.ps1",
    "native:shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-native-shortcut.ps1",
    "native:package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/native-package.ps1",
    "native:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/native-install.ps1",
    "native:update": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/native-update.ps1",
    "native:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/native-uninstall.ps1",
    "native:lifecycle-test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/tests/native-install-lifecycle.tests.ps1",
    "native:build": "dotnet build native/EmsScout.Native.slnx -c Debug --no-restore /p:UseSharedCompilation=false",
    "native:test": "dotnet test native/tests/EmsScout.Tests/EmsScout.Tests.csproj -c Debug --no-restore /p:UseSharedCompilation=false",
    "self-test": "node scripts/self-test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "playwright": "^1.60.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
