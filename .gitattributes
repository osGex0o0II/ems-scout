# Normalize all text files to LF in blobs; working tree follows platform/autocrlf.
* text=auto

# Binary assets must never be EOL-converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.db binary
*.db-shm binary
*.db-wal binary
*.xlsx binary
*.zip binary
*.pfx binary
*.cer binary
*.msix binary
*.appx binary
*.appinstaller text
