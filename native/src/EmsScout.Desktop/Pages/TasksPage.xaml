<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Name="TaskRoot"
    x:Class="EmsScout.Desktop.Pages.TasksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:EmsScout.Desktop.Pages"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded"
    SizeChanged="Page_SizeChanged"
    NavigationCacheMode="Required"
    mc:Ignorable="d">
    <Page.Resources>
        <local:LogSeverityBrushConverter x:Key="LogSeverityBrushConverter" />
        <local:LogSeverityGlyphConverter x:Key="LogSeverityGlyphConverter" />
    </Page.Resources>
    <Grid Padding="{StaticResource PagePadding}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="3">
                <TextBlock Style="{StaticResource WorkbenchPageTitleStyle}" Text="采集任务" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="采集 EMS 空调数据并更新数据管理" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button
                    Click="StartTask_Click"
                    IsEnabled="{x:Bind ViewModel.CanStartTask, Mode=OneWay}"
                    Visibility="{x:Bind local:TasksPage.BoolToVisibility(ViewModel.IsStartHighlighted), Mode=OneWay}"
                    Style="{StaticResource PrimaryToolbarButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE768;" />
                        <TextBlock Text="{x:Bind ViewModel.StartButtonText, Mode=OneWay}" />
                    </StackPanel>
                </Button>
                <Button
                    Click="StartTask_Click"
                    IsEnabled="{x:Bind ViewModel.CanStartTask, Mode=OneWay}"
                    Visibility="{x:Bind local:TasksPage.InverseBoolToVisibility(ViewModel.IsStartHighlighted), Mode=OneWay}"
                    Style="{StaticResource ToolbarButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE768;" />
                        <TextBlock Text="{x:Bind ViewModel.StartButtonText, Mode=OneWay}" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="StopButton"
                    Click="StopTask_Click"
                    IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay}"
                    Style="{StaticResource PrimaryToolbarButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE71A;" />
                        <TextBlock Text="停止" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.OpenDataCommand}" Style="{StaticResource ToolbarButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE8A5;" />
                        <TextBlock Text="数据管理" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border
            Grid.Row="1"
            Padding="14,10"
            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
            CornerRadius="6">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    VerticalAlignment="Center"
                    FontSize="18"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Glyph="{x:Bind ViewModel.ReadinessGlyph, Mode=OneWay}" />
                <StackPanel Grid.Column="1" HorizontalAlignment="Left" Spacing="2">
                    <TextBlock
                        HorizontalAlignment="Left"
                        TextAlignment="Left"
                        FontWeight="SemiBold"
                        Text="{x:Bind ViewModel.ReadinessTitle, Mode=OneWay}" />
                </StackPanel>
                <Button
                    Grid.Column="2"
                    Command="{x:Bind ViewModel.OpenEmsCommand}"
                    Visibility="{x:Bind local:TasksPage.BoolToVisibility(ViewModel.IsOpenBrowserHighlighted), Mode=OneWay}"
                    Style="{StaticResource PrimaryToolbarButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE774;" />
                        <TextBlock Text="{x:Bind ViewModel.CollectionBrowserActionText, Mode=OneWay}" />
                    </StackPanel>
                </Button>
                <Button
                    Grid.Column="2"
                    Command="{x:Bind ViewModel.OpenEmsCommand}"
                    Visibility="{x:Bind local:TasksPage.InverseBoolToVisibility(ViewModel.IsOpenBrowserHighlighted), Mode=OneWay}"
                    Style="{StaticResource ToolbarButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE774;" />
                        <TextBlock Text="{x:Bind ViewModel.CollectionBrowserActionText, Mode=OneWay}" />
                    </StackPanel>
                </Button>
                <Button
                    Grid.Column="3"
                    Command="{x:Bind ViewModel.CheckEnvironmentCommand}"
                    Style="{StaticResource ToolbarButtonStyle}"
                    ToolTipService.ToolTip="重新检查采集环境">
                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                </Button>
            </Grid>
        </Border>

        <Grid x:Name="WorkflowGrid" Grid.Row="2" ColumnSpacing="14" RowSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SetupColumn" Width="0.9*" />
                <ColumnDefinition x:Name="ExecutionColumn" Width="1.35*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="SetupRow" Height="*" />
                <RowDefinition x:Name="ExecutionRow" Height="0" />
            </Grid.RowDefinitions>

            <ScrollViewer x:Name="SetupPanel" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <Border Style="{StaticResource WorkbenchCardStyle}">
                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="采集范围" />
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.SelectedBuildingsText, Mode=OneWay}" />
                                </StackPanel>
                                <Button Grid.Column="1" Command="{x:Bind ViewModel.SelectAllBuildingsCommand}" Style="{StaticResource ToolbarButtonStyle}" Content="全选" />
                                <Button Grid.Column="2" Command="{x:Bind ViewModel.ClearBuildingSelectionCommand}" Style="{StaticResource ToolbarButtonStyle}" Content="清空" />
                            </Grid>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Buildings, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox
                                            MinWidth="118"
                                            Margin="0,0,8,5"
                                            Content="{Binding Label}"
                                            IsEnabled="{Binding ViewModel.CanEditTaskOptions, ElementName=TaskRoot}"
                                            IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource WorkbenchCardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="高级设置" />
                            <Grid ColumnSpacing="8" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox
                                    Header="日志级别"
                                    IsEnabled="{x:Bind ViewModel.CanEditTaskOptions, Mode=OneWay}"
                                    ItemsSource="{x:Bind ViewModel.LogSeverityOptions, Mode=OneWay}"
                                    SelectedItem="{x:Bind ViewModel.SelectedLogSeverity, Mode=TwoWay}" />
                                <ComboBox
                                    Grid.Column="1"
                                    Header="实时批量设备数"
                                    IsEnabled="{x:Bind ViewModel.CanEditTaskOptions, Mode=OneWay}"
                                    ItemsSource="{x:Bind ViewModel.RealtimeBatchSizeOptions, Mode=OneWay}"
                                    SelectedItem="{x:Bind ViewModel.RealtimeBatchSize, Mode=TwoWay}" />
                            </Grid>
                            <Grid ColumnSpacing="8" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox
                                    Header="单批超时（毫秒）"
                                    IsEnabled="{x:Bind ViewModel.CanEditTaskOptions, Mode=OneWay}"
                                    ItemsSource="{x:Bind ViewModel.RealtimeTimeoutOptions, Mode=OneWay}"
                                    SelectedItem="{x:Bind ViewModel.RealtimeTimeoutMs, Mode=TwoWay}" />
                                <ComboBox
                                    Grid.Column="1"
                                    Header="设备批次重开间隔"
                                    IsEnabled="{x:Bind ViewModel.CanEditTaskOptions, Mode=OneWay}"
                                    ItemsSource="{x:Bind ViewModel.RealtimeReopenEveryOptions, Mode=OneWay}"
                                    SelectedItem="{x:Bind ViewModel.RealtimeReopenEvery, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid x:Name="ExecutionPanel" Grid.Column="1" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource WorkbenchCardStyle}">
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ProgressRing
                                Width="16"
                                Height="16"
                                IsActive="{x:Bind ViewModel.IsRunning, Mode=OneWay}"
                                VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="任务进度" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" VerticalAlignment="Bottom" FontWeight="SemiBold" Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" />
                        </Grid>
                        <Border
                            x:Name="CompletionBanner"
                            Padding="12,10"
                            Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                            CornerRadius="6"
                            Visibility="{x:Bind local:TasksPage.BoolToVisibility(ViewModel.ShowCompletionCelebration), Mode=OneWay}">
                            <Border.Transitions>
                                <TransitionCollection>
                                    <EntranceThemeTransition FromVerticalOffset="-18" />
                                </TransitionCollection>
                            </Border.Transitions>
                            <Grid ColumnSpacing="10">
                                <Grid Width="30" Height="30" VerticalAlignment="Center">
                                    <FontIcon
                                        FontSize="24"
                                        Glyph="&#xE73E;"
                                        Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                </Grid>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                        Text="{x:Bind ViewModel.CollectionCompletionText, Mode=OneWay}" />
                                    <StackPanel Orientation="Horizontal" Spacing="14">
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.CollectionCompletedAtText, Mode=OneWay}" />
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.CollectionDurationText, Mode=OneWay}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <StackPanel Spacing="6">
                            <ProgressBar IsIndeterminate="{x:Bind ViewModel.IsRunning, Mode=OneWay}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="楼栋采集状态" />
                                <TextBlock Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.ProgressElapsedText, Mode=OneWay}" />
                            </Grid>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.ProgressBuildings, Mode=OneWay}">
                                <ItemsControl.Transitions>
                                    <TransitionCollection>
                                        <EntranceThemeTransition FromHorizontalOffset="14" />
                                    </TransitionCollection>
                                </ItemsControl.Transitions>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,5" Margin="0,0,6,4" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <Grid Width="18" Height="18">
                                                    <FontIcon FontSize="13" Glyph="{Binding StateGlyph}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                    <ProgressRing Width="18" Height="18" IsActive="{Binding IsCurrent}" IsIndeterminate="True" />
                                                </Grid>
                                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Building}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.ProgressLocationText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.ProgressSpeedText, Mode=OneWay}" />
                            </Grid>
                        </StackPanel>
                        <ItemsControl
                            x:Name="StagesList"
                            ItemsSource="{x:Bind ViewModel.Stages, Mode=OneWay}"
                            Visibility="Collapsed">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,6" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon FontSize="12" Glyph="&#xE915;" />
                                        <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding Label}" />
                                        <TextBlock Grid.Column="2" Text="{Binding State}" />
                                        <TextBlock Grid.Column="3" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" VerticalAlignment="Top" Style="{StaticResource WorkbenchCardStyle}">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="运行记录" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="失败时自动展开用于排查" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                <Button Click="CopyLogs_Click" Style="{StaticResource ToolbarButtonStyle}" ToolTipService.ToolTip="复制日志">
                                    <FontIcon FontSize="13" Glyph="&#xE8C8;" />
                                </Button>
                                <Button Click="ClearLogs_Click" Style="{StaticResource ToolbarButtonStyle}" ToolTipService.ToolTip="清空日志">
                                    <FontIcon FontSize="13" Glyph="&#xE74D;" />
                                </Button>
                            </StackPanel>
                        </Grid>
                        <ListView
                            x:Name="LogsList"
                            Grid.Row="2"
                            ItemsSource="{x:Bind ViewModel.FilteredLogs, Mode=OneWay}"
                            MaxHeight="260"
                            SelectionMode="None"
                            ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,2" ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="58" />
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{Binding Time}" />
                                        <FontIcon Grid.Column="1" FontSize="12" Glyph="{Binding Severity, Converter={StaticResource LogSeverityGlyphConverter}}" Foreground="{Binding Severity, Converter={StaticResource LogSeverityBrushConverter}}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Message}" ToolTipService.ToolTip="{Binding Message}" TextWrapping="WrapWholeWords" Foreground="{Binding Severity, Converter={StaticResource LogSeverityBrushConverter}}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
