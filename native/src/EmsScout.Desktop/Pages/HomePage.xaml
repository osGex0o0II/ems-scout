<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="EmsScout.Desktop.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:EmsScout.Desktop.ViewModels"
    Loaded="Page_Loaded"
    SizeChanged="Page_SizeChanged"
    mc:Ignorable="d">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="14">
            <Grid x:Name="PageHeader" ColumnSpacing="16" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="3">
                    <TextBlock Style="{StaticResource WorkbenchPageTitleStyle}" Text="EMS 运维工作台" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.PageStatus, Mode=OneWay}" />
                </StackPanel>
                <Grid
                    x:Name="HeaderActions"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="270" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Grid.Column="0"
                        Width="32"
                        Height="32"
                        AutomationProperties.Name="{x:Bind ViewModel.LatestBatchIndicatorAutomationName, Mode=OneWay}"
                        Click="LatestBatch_Click"
                        HorizontalContentAlignment="Center"
                        IsEnabled="{x:Bind ViewModel.CanRefresh, Mode=OneWay}"
                        Padding="0"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.LatestBatchIndicatorToolTip, Mode=OneWay}">
                        <Grid Width="18" Height="18">
                            <Ellipse
                                Width="14"
                                Height="14"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Fill="{ThemeResource SystemFillColorSuccessBrush}"
                                Opacity="{x:Bind ViewModel.LatestBatchIndicatorOpacity, Mode=OneWay}" />
                            <Ellipse
                                Width="14"
                                Height="14"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Fill="{ThemeResource SystemFillColorCautionBrush}"
                                Opacity="{x:Bind ViewModel.HistoricalBatchIndicatorOpacity, Mode=OneWay}" />
                        </Grid>
                    </Button>
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="历史批次" />
                    <ComboBox
                        Grid.Column="2"
                        Width="270"
                        VerticalContentAlignment="Center"
                        DisplayMemberPath="DisplayLabel"
                        ItemsSource="{x:Bind ViewModel.HistoricalDataSources, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedDataSource, Mode=TwoWay}"
                        IsEnabled="{x:Bind ViewModel.CanChangeDataSource, Mode=OneWay}"
                        SelectionChanged="DataSource_SelectionChanged" />
                    <ProgressRing
                        Grid.Column="3"
                        Width="20"
                        Height="20"
                        AutomationProperties.Name="正在刷新工作台"
                        IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.LoadingVisibility, Mode=OneWay}" />
                    <Button
                        Grid.Column="4"
                        Width="36"
                        Height="32"
                        AutomationProperties.Name="刷新工作台"
                        Click="Refresh_Click"
                        HorizontalContentAlignment="Center"
                        IsEnabled="{x:Bind ViewModel.CanRefresh, Mode=OneWay}"
                        Padding="0"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTipService.ToolTip="刷新工作台 (F5)">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F5" />
                        </Button.KeyboardAccelerators>
                        <SymbolIcon Symbol="Refresh" />
                    </Button>
                </Grid>
            </Grid>

            <InfoBar
                AutomationProperties.Name="工作台数据状态"
                IsClosable="False"
                IsOpen="True"
                Message="{x:Bind ViewModel.OverviewStatusMessage, Mode=OneWay}"
                Severity="{x:Bind ViewModel.OverviewSeverity, Mode=OneWay}"
                Title="{x:Bind ViewModel.OverviewStatusTitle, Mode=OneWay}" />

            <GridView
                AutomationProperties.Name="核心运行指标"
                IsItemClickEnabled="True"
                ItemsSource="{x:Bind ViewModel.Metrics, Mode=OneWay}"
                ItemClick="Metrics_ItemClick"
                SelectionMode="None">
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="MinWidth" Value="176" />
                        <Setter Property="MinHeight" Value="104" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="vm:MetricItem">
                        <Border Style="{StaticResource MetricCardStyle}">
                            <Grid RowSpacing="5">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Label}" />
                                <TextBlock Grid.Row="1" FontSize="26" FontWeight="SemiBold" Text="{x:Bind Value}" />
                                <TextBlock
                                    Grid.Row="2"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="{x:Bind Detail}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{x:Bind Detail}" />
                                <TextBlock Grid.Row="3" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="{x:Bind ActionText}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <Grid x:Name="PrimaryWorkspace" ColumnSpacing="14" RowSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.22*" />
                    <ColumnDefinition x:Name="SecondaryWorkspaceColumn" Width="0" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource WorkbenchCardStyle}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Padding="16,14,16,8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="我的区域组" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.AreaGroupsStatus, Mode=OneWay}"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                AutomationProperties.Name="管理区域组"
                                Click="OpenAreaGroups_Click"
                                Style="{StaticResource ToolbarButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="14" Glyph="&#xE707;" />
                                    <TextBlock Text="管理区域组" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Grid
                            Grid.Row="1"
                            Visibility="{x:Bind ViewModel.AreaGroupsListVisibility, Mode=OneWay}">
                        <ListView
                            x:Name="WideAreaGroupList"
                            AutomationProperties.Name="我的区域组列表"
                            IsItemClickEnabled="True"
                            ItemsSource="{x:Bind ViewModel.AreaGroups, Mode=OneWay}"
                            ItemClick="AreaGroups_ItemClick"
                            SelectionMode="None"
                            Visibility="Collapsed">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.Header>
                                <Grid Padding="16,9" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" MinWidth="190" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="94" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontWeight="SemiBold" Text="区域组 / 覆盖范围" />
                                    <TextBlock Grid.Column="1" HorizontalAlignment="Right" FontWeight="SemiBold" Text="设备" />
                                    <TextBlock Grid.Column="2" HorizontalAlignment="Right" FontWeight="SemiBold" Text="公区" />
                                    <TextBlock Grid.Column="3" HorizontalAlignment="Right" FontWeight="SemiBold" Text="非公区" />
                                    <TextBlock Grid.Column="4" HorizontalAlignment="Right" FontWeight="SemiBold" Text="在线" />
                                    <TextBlock Grid.Column="5" HorizontalAlignment="Right" FontWeight="SemiBold" Text="离线" />
                                    <TextBlock Grid.Column="6" HorizontalAlignment="Right" FontWeight="SemiBold" Text="开机" />
                                    <TextBlock Grid.Column="7" HorizontalAlignment="Right" FontWeight="SemiBold" Text="关机" />
                                    <TextBlock Grid.Column="8" HorizontalAlignment="Right" FontWeight="SemiBold" Text="公区开机" />
                                    <TextBlock Grid.Column="9" HorizontalAlignment="Right" FontWeight="SemiBold" Text="公区关机" />
                                </Grid>
                            </ListView.Header>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:DashboardAreaGroupRow">
                                    <Grid
                                        MinHeight="62"
                                        Padding="16,9"
                                        AutomationProperties.Name="{x:Bind AutomationName}"
                                        ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" MinWidth="190" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="92" />
                                            <ColumnDefinition Width="92" />
                                            <ColumnDefinition Width="94" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" />
                                                <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{x:Bind Priority}" />
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon FontSize="12" Glyph="{x:Bind Glyph}" />
                                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind StateText}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                Text="{x:Bind ScopeText}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTipService.ToolTip="{x:Bind Description}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Text="{x:Bind Total}" />
                                        <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Text="{x:Bind PublicTotal}" />
                                        <TextBlock Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Text="{x:Bind PrivateTotal}" />
                                        <TextBlock Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource SystemFillColorSuccessBrush}" FontWeight="SemiBold" Text="{x:Bind Online}" />
                                        <TextBlock Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontWeight="SemiBold" Text="{x:Bind Offline}" />
                                        <TextBlock Grid.Column="6" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource SystemFillColorSuccessBrush}" FontWeight="SemiBold" Text="{x:Bind Running}" />
                                        <TextBlock Grid.Column="7" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Text="{x:Bind Stopped}" />
                                        <TextBlock Grid.Column="8" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource SystemFillColorSuccessBrush}" FontWeight="SemiBold" Text="{x:Bind PublicRunning}" />
                                        <TextBlock Grid.Column="9" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Text="{x:Bind PublicStopped}" />
                                        <StackPanel Grid.Column="10" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="5">
                                            <TextBlock Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="查看设备" />
                                            <FontIcon Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE76C;" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <ListView
                            x:Name="CompactAreaGroupList"
                            AutomationProperties.Name="我的区域组紧凑列表"
                            IsItemClickEnabled="True"
                            ItemsSource="{x:Bind ViewModel.AreaGroups, Mode=OneWay}"
                            ItemClick="AreaGroups_ItemClick"
                            SelectionMode="None"
                            Visibility="Visible">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:DashboardAreaGroupRow">
                                    <Grid
                                        MinHeight="104"
                                        Padding="16,10"
                                        AutomationProperties.Name="{x:Bind AutomationName}"
                                        RowSpacing="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" />
                                                <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{x:Bind Priority}" />
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon FontSize="12" Glyph="{x:Bind Glyph}" />
                                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind StateText}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <FontIcon Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE76C;" />
                                        </Grid>
                                        <TextBlock
                                            Grid.Row="1"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Text="{x:Bind ScopeText}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{x:Bind Description}" />
                                        <Grid Grid.Row="2" ColumnSpacing="8" RowSpacing="8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="1">
                                                <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="设备" />
                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind Total}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="1">
                                                <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="在线" />
                                                <TextBlock Foreground="{ThemeResource SystemFillColorSuccessBrush}" FontWeight="SemiBold" Text="{x:Bind Online}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="1">
                                                <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="离线" />
                                                <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontWeight="SemiBold" Text="{x:Bind Offline}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Spacing="1">
                                                <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="开机" />
                                                <TextBlock Foreground="{ThemeResource SystemFillColorSuccessBrush}" FontWeight="SemiBold" Text="{x:Bind Running}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4" Spacing="1">
                                                <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="关机" />
                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind Stopped}" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Spacing="1">
                                                <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="公区开机" />
                                                <TextBlock Foreground="{ThemeResource SystemFillColorSuccessBrush}" FontWeight="SemiBold" Text="{x:Bind PublicRunning}" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="1">
                                                <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="公区关机" />
                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind PublicStopped}" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="2" Spacing="1">
                                                <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="公区" />
                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind PublicTotal}" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="3" Spacing="1">
                                                <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="非公区" />
                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind PrivateTotal}" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        </Grid>

                        <StackPanel
                            Grid.Row="2"
                            Padding="20,22"
                            HorizontalAlignment="Center"
                            Spacing="8"
                            Visibility="{x:Bind ViewModel.AreaGroupsEmptyVisibility, Mode=OneWay}">
                            <FontIcon FontSize="22" Glyph="&#xE707;" />
                            <TextBlock FontWeight="SemiBold" Text="暂无启用的自定义区域组" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="在区域组中添加要关注的楼层或设备。"
                                TextAlignment="Center" />
                        </StackPanel>

                        <StackPanel
                            Grid.Row="2"
                            Padding="20,22"
                            HorizontalAlignment="Center"
                            Spacing="8"
                            Visibility="{x:Bind ViewModel.AreaGroupsErrorVisibility, Mode=OneWay}">
                            <FontIcon FontSize="22" Glyph="&#xE783;" />
                            <TextBlock FontWeight="SemiBold" Text="区域组统计读取失败" />
                            <TextBlock
                                MaxWidth="560"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.AreaGroupsError, Mode=OneWay}"
                                TextAlignment="Center"
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="RiskPanel" Grid.Row="1" Style="{StaticResource WorkbenchCardStyle}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Padding="16,14,16,8" Spacing="2">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="优先处理" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="质量、实时对账、批次和关注设备的行动项。"
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>
                        <ListView
                            Grid.Row="1"
                            AutomationProperties.Name="优先处理事项"
                            IsItemClickEnabled="True"
                            ItemsSource="{x:Bind ViewModel.Risks, Mode=OneWay}"
                            ItemClick="Risks_ItemClick"
                            SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:DashboardRiskRow">
                                    <Grid MinHeight="58" Padding="16,8" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon FontSize="14" Glyph="{x:Bind Glyph}" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" />
                                                <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{x:Bind Source}" />
                                            </StackPanel>
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                MaxLines="2"
                                                Text="{x:Bind Detail}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="WrapWholeWords"
                                                ToolTipService.ToolTip="{x:Bind Detail}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold" Text="{x:Bind CountText}" />
                                            <TextBlock HorizontalAlignment="Right" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="{x:Bind ActionText}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>

            <Border Style="{StaticResource WorkbenchCardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Padding="16,14,16,8" Spacing="2">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="楼栋运行状态" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="点击楼栋进入数据管理；总数与状态均使用当前工作台快照。" />
                    </StackPanel>
                    <ListView
                        Grid.Row="1"
                        AutomationProperties.Name="楼栋运行状态列表"
                        IsItemClickEnabled="True"
                        ItemsSource="{x:Bind ViewModel.Buildings, Mode=OneWay}"
                        ItemClick="Buildings_ItemClick"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.Header>
                            <Grid MinWidth="760" Padding="16,9" ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="28" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontWeight="SemiBold" Text="楼栋" />
                                <TextBlock Grid.Column="1" HorizontalAlignment="Right" FontWeight="SemiBold" Text="总数" />
                                <TextBlock Grid.Column="2" HorizontalAlignment="Right" FontWeight="SemiBold" Text="开机" />
                                <TextBlock Grid.Column="3" HorizontalAlignment="Right" FontWeight="SemiBold" Text="关机" />
                                <TextBlock Grid.Column="4" HorizontalAlignment="Right" FontWeight="SemiBold" Text="离线" />
                                <TextBlock Grid.Column="5" HorizontalAlignment="Right" FontWeight="SemiBold" Text="未知" />
                                <TextBlock Grid.Column="6" HorizontalAlignment="Right" FontWeight="SemiBold" Text="开机率" />
                                <TextBlock Grid.Column="7" HorizontalAlignment="Right" FontWeight="SemiBold" Text="离线率" />
                            </Grid>
                        </ListView.Header>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:BuildingSummaryRow">
                                <Grid MinWidth="760" MinHeight="44" Padding="16,9" ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="28" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{x:Bind Building}" />
                                    <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{x:Bind Total}" />
                                    <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Text="{x:Bind Running}" />
                                    <TextBlock Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{x:Bind Stopped}" />
                                    <TextBlock Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Text="{x:Bind Offline}" />
                                    <TextBlock Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource SystemFillColorCautionBrush}" Text="{x:Bind Unknown}" />
                                    <TextBlock Grid.Column="6" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{x:Bind RunningRate}" />
                                    <TextBlock Grid.Column="7" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{x:Bind OfflineRate}" />
                                    <FontIcon Grid.Column="8" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE76C;" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
