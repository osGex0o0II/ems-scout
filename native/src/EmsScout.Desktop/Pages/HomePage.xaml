<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="EmsScout.Desktop.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:EmsScout.Desktop.ViewModels"
    Loaded="Page_Loaded"
    SizeChanged="Page_SizeChanged"
    mc:Ignorable="d">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="14">
            <Grid x:Name="PageHeader" ColumnSpacing="16" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="3">
                    <TextBlock Style="{StaticResource WorkbenchPageTitleStyle}" Text="EMS Scout" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="{x:Bind ViewModel.RealtimeStatusText, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        ToolTipService.ToolTip="{x:Bind ViewModel.RealtimeStatusText, Mode=OneWay}" />
                </StackPanel>
                <Grid
                    x:Name="HeaderActions"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Grid.Column="0"
                        Width="32"
                        Height="32"
                        AutomationProperties.Name="{x:Bind ViewModel.LatestBatchIndicatorAutomationName, Mode=OneWay}"
                        Click="LatestBatch_Click"
                        HorizontalContentAlignment="Center"
                        IsEnabled="{x:Bind ViewModel.CanRefresh, Mode=OneWay}"
                        Padding="0"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.LatestBatchIndicatorToolTip, Mode=OneWay}">
                        <Grid Width="18" Height="18">
                            <Ellipse
                                Width="14"
                                Height="14"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Fill="{ThemeResource SystemFillColorSuccessBrush}"
                                Opacity="{x:Bind ViewModel.LatestBatchIndicatorOpacity, Mode=OneWay}" />
                            <Ellipse
                                Width="14"
                                Height="14"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Fill="{ThemeResource SystemFillColorCautionBrush}"
                                Opacity="{x:Bind ViewModel.HistoricalBatchIndicatorOpacity, Mode=OneWay}" />
                        </Grid>
                    </Button>
                    <ComboBox
                        Grid.Column="1"
                        MaxWidth="420"
                        AutomationProperties.Name="数据批次时间"
                        HorizontalAlignment="Left"
                        VerticalContentAlignment="Center"
                        ItemsSource="{x:Bind ViewModel.HistoricalDataSources, Mode=OneWay}"
                        PlaceholderText="{x:Bind ViewModel.CurrentBatchTimestamp, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedDataSource, Mode=TwoWay}"
                        IsEnabled="{x:Bind ViewModel.CanChangeDataSource, Mode=OneWay}"
                        SelectionChanged="DataSource_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayLabel}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ProgressRing
                        Grid.Column="2"
                        Width="16"
                        Height="16"
                        AutomationProperties.Name="正在刷新工作台"
                        IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.LoadingVisibility, Mode=OneWay}" />
                    <Button
                        Grid.Column="3"
                        Width="36"
                        Height="32"
                        AutomationProperties.Name="刷新工作台"
                        Click="Refresh_Click"
                        HorizontalContentAlignment="Center"
                        IsEnabled="{x:Bind ViewModel.CanRefresh, Mode=OneWay}"
                        Padding="0"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTipService.ToolTip="刷新工作台 (F5)">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F5" />
                        </Button.KeyboardAccelerators>
                        <SymbolIcon Symbol="Refresh" />
                    </Button>
                </Grid>
            </Grid>

            <GridView
                x:Name="MetricsGrid"
                AutomationProperties.Name="核心运行指标"
                IsItemClickEnabled="True"
                ItemsSource="{x:Bind ViewModel.Metrics, Mode=OneWay}"
                ItemClick="Metrics_ItemClick"
                ContainerContentChanging="MetricsGrid_ContainerContentChanging"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Top"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.HorizontalScrollMode="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollMode="Disabled"
                SizeChanged="MetricsGrid_SizeChanged"
                SelectionMode="None">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="MinWidth" Value="0" />
                        <Setter Property="MinHeight" Value="104" />
                        <Setter Property="Margin" Value="4,0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Top" />
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="vm:MetricItem">
                        <Border Style="{StaticResource MetricCardStyle}">
                            <Grid RowSpacing="5">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Label}" />
                                <TextBlock Grid.Row="1" FontSize="26" FontWeight="SemiBold" Text="{x:Bind Value}" />
                                <TextBlock
                                    Grid.Row="2"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="{x:Bind Detail}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{x:Bind Detail}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <Grid x:Name="PrimaryWorkspace" ColumnSpacing="14" RowSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.22*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource WorkbenchCardStyle}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Padding="16,14,16,8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="我的区域组" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                AutomationProperties.Name="管理区域组"
                                Click="OpenAreaGroups_Click"
                                Style="{StaticResource ToolbarButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="14" Glyph="&#xE707;" />
                                    <TextBlock Text="管理区域组" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Grid
                            Grid.Row="1"
                            Visibility="{x:Bind ViewModel.AreaGroupsListVisibility, Mode=OneWay}">
                        <ListView
                            x:Name="WideAreaGroupList"
                            AutomationProperties.Name="我的区域组列表"
                            IsItemClickEnabled="True"
                            ItemsSource="{x:Bind ViewModel.AreaGroups, Mode=OneWay}"
                            ItemClick="AreaGroups_ItemClick"
                            HorizontalContentAlignment="Stretch"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            SelectionMode="None"
                            Visibility="Collapsed">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.Header>
                                <Grid HorizontalAlignment="Stretch" Padding="16,9" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" MinWidth="180" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="96" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontWeight="SemiBold" Text="区域组 / 覆盖范围" />
                                    <TextBlock Grid.Column="1" HorizontalAlignment="Right" FontWeight="SemiBold" Text="设备" />
                                    <TextBlock Grid.Column="2" HorizontalAlignment="Right" FontWeight="SemiBold" Text="在线" />
                                    <TextBlock Grid.Column="3" HorizontalAlignment="Right" FontWeight="SemiBold" Text="离线" />
                                    <TextBlock Grid.Column="4" HorizontalAlignment="Right" FontWeight="SemiBold" Text="开机" />
                                    <TextBlock Grid.Column="5" HorizontalAlignment="Right" FontWeight="SemiBold" Text="关机" />
                                    <TextBlock Grid.Column="6" HorizontalAlignment="Right" FontWeight="SemiBold" Text="模式异常" />
                                    <TextBlock Grid.Column="7" HorizontalAlignment="Right" FontWeight="SemiBold" Text="温度异常" />
                                    <TextBlock Grid.Column="8" HorizontalAlignment="Right" FontWeight="SemiBold" Text="集控锁开" />
                                    <TextBlock Grid.Column="9" HorizontalAlignment="Right" FontWeight="SemiBold" Text="集控锁关" />
                                    <TextBlock Grid.Column="10" HorizontalAlignment="Right" FontWeight="SemiBold" Text="操作" />
                                </Grid>
                            </ListView.Header>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:DashboardAreaGroupRow">
                                    <Grid
                                        MinHeight="62"
                                        HorizontalAlignment="Stretch"
                                        Padding="16,9"
                                        AutomationProperties.Name="{x:Bind AutomationName}"
                                        ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" MinWidth="180" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="96" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" />
                                                <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{x:Bind Description}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Description}" />
                                            </StackPanel>
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                Text="{x:Bind ScopeText}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTipService.ToolTip="{x:Bind Description}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource AreaGroupMetricButtonStyle}" Content="{x:Bind Total}" Tag="{x:Bind TotalNavigationRequest}" Click="AreaGroupMetric_Click" AutomationProperties.Name="查看设备筛选结果" />
                                        <Button Grid.Column="2" Style="{StaticResource AreaGroupMetricButtonStyle}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Content="{x:Bind Online}" Tag="{x:Bind OnlineNavigationRequest}" Click="AreaGroupMetric_Click" AutomationProperties.Name="查看在线筛选结果" />
                                        <Button Grid.Column="3" Style="{StaticResource AreaGroupMetricButtonStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Content="{x:Bind Offline}" Tag="{x:Bind OfflineNavigationRequest}" Click="AreaGroupMetric_Click" AutomationProperties.Name="查看离线筛选结果" />
                                        <Button Grid.Column="4" Style="{StaticResource AreaGroupMetricButtonStyle}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Content="{x:Bind Running}" Tag="{x:Bind RunningNavigationRequest}" Click="AreaGroupMetric_Click" AutomationProperties.Name="查看开机筛选结果" />
                                        <Button Grid.Column="5" Style="{StaticResource AreaGroupMetricButtonStyle}" Content="{x:Bind Stopped}" Tag="{x:Bind StoppedNavigationRequest}" Click="AreaGroupMetric_Click" AutomationProperties.Name="查看关机筛选结果" />
                                        <Button Grid.Column="6" Style="{StaticResource AreaGroupMetricButtonStyle}" Foreground="{ThemeResource SystemFillColorCautionBrush}" Content="{x:Bind ModeAbnormal}" Tag="{x:Bind ModeAbnormalNavigationRequest}" Click="AreaGroupMetric_Click" AutomationProperties.Name="查看模式异常筛选结果" />
                                        <Button Grid.Column="7" Style="{StaticResource AreaGroupMetricButtonStyle}" Foreground="{ThemeResource SystemFillColorCautionBrush}" Content="{x:Bind TemperatureAbnormal}" Tag="{x:Bind TemperatureAbnormalNavigationRequest}" Click="AreaGroupMetric_Click" AutomationProperties.Name="查看温度异常筛选结果" />
                                        <Button Grid.Column="8" Style="{StaticResource AreaGroupMetricButtonStyle}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Content="{x:Bind LockOn}" Tag="{x:Bind LockOnNavigationRequest}" Click="AreaGroupMetric_Click" IsEnabled="{x:Bind CanNavigateLock}" AutomationProperties.Name="查看集控锁开启筛选结果" />
                                        <Button Grid.Column="9" Style="{StaticResource AreaGroupMetricButtonStyle}" Content="{x:Bind LockOff}" Tag="{x:Bind LockOffNavigationRequest}" Click="AreaGroupMetric_Click" IsEnabled="{x:Bind CanNavigateLock}" AutomationProperties.Name="查看集控锁关闭筛选结果" />
                                        <StackPanel Grid.Column="10" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="5">
                                            <TextBlock Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="查看设备" />
                                            <FontIcon Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE76C;" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <ListView
                            x:Name="CompactAreaGroupList"
                            AutomationProperties.Name="我的区域组紧凑列表"
                            IsItemClickEnabled="True"
                            ItemsSource="{x:Bind ViewModel.AreaGroups, Mode=OneWay}"
                            ItemClick="AreaGroups_ItemClick"
                            SelectionMode="None"
                            Visibility="Visible">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:DashboardAreaGroupRow">
                                    <Grid
                                        MinHeight="78"
                                        Padding="12,7"
                                        AutomationProperties.Name="{x:Bind AutomationName}"
                                        RowSpacing="4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                              <StackPanel Orientation="Horizontal" Spacing="6">
                                                  <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" />
                                                  <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{x:Bind Description}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Description}" />
                                              </StackPanel>
                                            <TextBlock
                                                Grid.Column="1"
                                                HorizontalAlignment="Right"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                Text="{x:Bind ScopeText}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTipService.ToolTip="{x:Bind Description}" />
                                            <FontIcon Grid.Column="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE76C;" />
                                        </Grid>
                                        <Grid Grid.Row="1" ColumnSpacing="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel HorizontalAlignment="Center" Spacing="0">
                                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="设备" />
                                                <Button Style="{StaticResource AreaGroupMetricButtonStyle}" Content="{x:Bind Total}" Tag="{x:Bind TotalNavigationRequest}" Click="AreaGroupMetric_Click" AutomationProperties.Name="查看设备筛选结果" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Center" Spacing="0">
                                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="在线" />
                                                <Button Style="{StaticResource AreaGroupMetricButtonStyle}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Content="{x:Bind Online}" Tag="{x:Bind OnlineNavigationRequest}" Click="AreaGroupMetric_Click" AutomationProperties.Name="查看在线筛选结果" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Center" Spacing="0">
                                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="离线" />
                                                <Button Style="{StaticResource AreaGroupMetricButtonStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Content="{x:Bind Offline}" Tag="{x:Bind OfflineNavigationRequest}" Click="AreaGroupMetric_Click" AutomationProperties.Name="查看离线筛选结果" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" HorizontalAlignment="Center" Spacing="0">
                                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="开机" />
                                                <Button Style="{StaticResource AreaGroupMetricButtonStyle}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Content="{x:Bind Running}" Tag="{x:Bind RunningNavigationRequest}" Click="AreaGroupMetric_Click" AutomationProperties.Name="查看开机筛选结果" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4" HorizontalAlignment="Center" Spacing="0">
                                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="关机" />
                                                <Button Style="{StaticResource AreaGroupMetricButtonStyle}" Content="{x:Bind Stopped}" Tag="{x:Bind StoppedNavigationRequest}" Click="AreaGroupMetric_Click" AutomationProperties.Name="查看关机筛选结果" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="5" HorizontalAlignment="Center" Spacing="0">
                                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="模式异常" />
                                                <Button Style="{StaticResource AreaGroupMetricButtonStyle}" Foreground="{ThemeResource SystemFillColorCautionBrush}" Content="{x:Bind ModeAbnormal}" Tag="{x:Bind ModeAbnormalNavigationRequest}" Click="AreaGroupMetric_Click" AutomationProperties.Name="查看模式异常筛选结果" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="6" HorizontalAlignment="Center" Spacing="0">
                                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="温度异常" />
                                                <Button Style="{StaticResource AreaGroupMetricButtonStyle}" Foreground="{ThemeResource SystemFillColorCautionBrush}" Content="{x:Bind TemperatureAbnormal}" Tag="{x:Bind TemperatureAbnormalNavigationRequest}" Click="AreaGroupMetric_Click" AutomationProperties.Name="查看温度异常筛选结果" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="7" HorizontalAlignment="Center" Spacing="0">
                                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="集控锁开" />
                                                <Button Style="{StaticResource AreaGroupMetricButtonStyle}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Content="{x:Bind LockOn}" Tag="{x:Bind LockOnNavigationRequest}" Click="AreaGroupMetric_Click" IsEnabled="{x:Bind CanNavigateLock}" AutomationProperties.Name="查看集控锁开启筛选结果" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="8" HorizontalAlignment="Center" Spacing="0">
                                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="集控锁关" />
                                                <Button Style="{StaticResource AreaGroupMetricButtonStyle}" Content="{x:Bind LockOff}" Tag="{x:Bind LockOffNavigationRequest}" Click="AreaGroupMetric_Click" IsEnabled="{x:Bind CanNavigateLock}" AutomationProperties.Name="查看集控锁关闭筛选结果" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        </Grid>

                        <StackPanel
                            Grid.Row="2"
                            Padding="20,22"
                            HorizontalAlignment="Center"
                            Spacing="8"
                            Visibility="{x:Bind ViewModel.AreaGroupsEmptyVisibility, Mode=OneWay}">
                            <FontIcon FontSize="22" Glyph="&#xE707;" />
                            <TextBlock FontWeight="SemiBold" Text="暂无启用的自定义区域组" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="在区域组中添加要关注的楼层或设备。"
                                TextAlignment="Center" />
                        </StackPanel>

                        <StackPanel
                            Grid.Row="2"
                            Padding="20,22"
                            HorizontalAlignment="Center"
                            Spacing="8"
                            Visibility="{x:Bind ViewModel.AreaGroupsErrorVisibility, Mode=OneWay}">
                            <FontIcon FontSize="22" Glyph="&#xE783;" />
                            <TextBlock FontWeight="SemiBold" Text="区域组统计读取失败" />
                            <TextBlock
                                MaxWidth="560"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.AreaGroupsError, Mode=OneWay}"
                                TextAlignment="Center"
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Grid>
                </Border>

            </Grid>

            <Border Style="{StaticResource WorkbenchCardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Padding="16,14,16,8" Spacing="2">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="楼栋运行状态" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="点击楼栋进入数据管理；总数与状态均使用当前工作台快照。" />
                    </StackPanel>
                    <ListView
                        Grid.Row="1"
                        AutomationProperties.Name="楼栋运行状态列表"
                        IsItemClickEnabled="True"
                        ItemsSource="{x:Bind ViewModel.Buildings, Mode=OneWay}"
                        ItemClick="Buildings_ItemClick"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.Header>
                            <Grid MinWidth="760" Padding="16,9" ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="28" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontWeight="SemiBold" Text="楼栋" />
                                <TextBlock Grid.Column="1" HorizontalAlignment="Right" FontWeight="SemiBold" Text="总数" />
                                <TextBlock Grid.Column="2" HorizontalAlignment="Right" FontWeight="SemiBold" Text="开机" />
                                <TextBlock Grid.Column="3" HorizontalAlignment="Right" FontWeight="SemiBold" Text="关机" />
                                <TextBlock Grid.Column="4" HorizontalAlignment="Right" FontWeight="SemiBold" Text="离线" />
                                <TextBlock Grid.Column="5" HorizontalAlignment="Right" FontWeight="SemiBold" Text="未知" />
                                <TextBlock Grid.Column="6" HorizontalAlignment="Right" FontWeight="SemiBold" Text="开机率" />
                                <TextBlock Grid.Column="7" HorizontalAlignment="Right" FontWeight="SemiBold" Text="离线率" />
                            </Grid>
                        </ListView.Header>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:BuildingSummaryRow">
                                <Grid MinWidth="760" MinHeight="44" Padding="16,9" ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="28" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{x:Bind Building}" />
                                    <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{x:Bind Total}" />
                                    <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Text="{x:Bind Running}" />
                                    <TextBlock Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{x:Bind Stopped}" />
                                    <TextBlock Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Text="{x:Bind Offline}" />
                                    <TextBlock Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource SystemFillColorCautionBrush}" Text="{x:Bind Unknown}" />
                                    <TextBlock Grid.Column="6" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{x:Bind RunningRate}" />
                                    <TextBlock Grid.Column="7" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{x:Bind OfflineRate}" />
                                    <FontIcon Grid.Column="8" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE76C;" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
