<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="EmsScout.Desktop.Pages.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded"
    mc:Ignorable="d">

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="16">
            <StackPanel Spacing="3">
                <TextBlock Style="{StaticResource WorkbenchPageTitleStyle}" Text="关于 EMS Scout" />
            </StackPanel>

            <Grid HorizontalAlignment="Stretch" MaxWidth="960" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    x:Name="HeroSection"
                    Padding="24"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    Style="{StaticResource WorkbenchCardStyle}">
                    <Grid ColumnSpacing="20" RowSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="68"
                            Height="68"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Image
                                Width="46"
                                Height="46"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Source="ms-appx:///Assets/EmsScoutLogo.png"
                                Stretch="Uniform" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock FontSize="26" FontWeight="SemiBold" Text="EMS Scout" />
                            <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{x:Bind ViewModel.AuthorText, Mode=OneWay}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="{x:Bind ViewModel.RepositoryUrl, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Center">
                            <Button
                                AutomationProperties.Name="打开 GitHub 仓库"
                                Command="{x:Bind ViewModel.OpenRepositoryCommand}"
                                Style="{StaticResource PrimaryToolbarButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="14" Glyph="&#xE774;" />
                                    <TextBlock Text="打开 GitHub 仓库" />
                                </StackPanel>
                            </Button>
                            <Button
                                AutomationProperties.Name="复制仓库地址"
                                Command="{x:Bind ViewModel.CopyRepositoryCommand}"
                                Style="{StaticResource ToolbarButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                                    <TextBlock Text="复制仓库地址" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource WorkbenchCardStyle}">
                    <StackPanel Spacing="14">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="应用信息" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                AutomationProperties.Name="复制诊断信息"
                                Command="{x:Bind ViewModel.CopyDiagnosticsCommand}"
                                Style="{StaticResource ToolbarButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                                    <TextBlock Text="复制诊断信息" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.AppRows, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Label}" />
                                        <StackPanel Grid.Column="1" Spacing="1">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Value}" TextWrapping="WrapWholeWords" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource WorkbenchCardStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="设备信息" />
                        <Grid ColumnSpacing="16" RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="当前时间" />
                            <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{x:Bind ViewModel.CurrentSystemTime, Mode=OneWay}" />
                            <TextBlock Grid.Column="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="系统语言" />
                            <TextBlock Grid.Column="3" FontWeight="SemiBold" Text="{x:Bind ViewModel.SystemLanguage, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="系统时区" />
                            <TextBlock Grid.Row="1" Grid.Column="1" FontWeight="SemiBold" Text="{x:Bind ViewModel.SystemTimeZone, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="设备名称" />
                            <TextBlock Grid.Row="1" Grid.Column="3" FontWeight="SemiBold" Text="{x:Bind ViewModel.DeviceName, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Windows 版本" />
                            <TextBlock Grid.Row="2" Grid.Column="1" FontWeight="SemiBold" Text="{x:Bind ViewModel.WindowsVersion, Mode=OneWay}" TextWrapping="WrapWholeWords" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="处理器与内存" />
                            <TextBlock Grid.Row="2" Grid.Column="3" FontWeight="SemiBold" Text="{x:Bind ViewModel.ProcessorAndMemory, Mode=OneWay}" TextWrapping="WrapWholeWords" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
