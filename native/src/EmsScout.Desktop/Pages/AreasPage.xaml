<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="EmsScout.Desktop.Pages.AreasPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:EmsScout.Desktop.ViewModels"
    Loaded="Page_Loaded">
    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="3">
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="区域组" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
            </StackPanel>
            <Button Grid.Column="1" AutomationProperties.Name="刷新" Command="{x:Bind ViewModel.RefreshCommand}" IsEnabled="{x:Bind ViewModel.CanRefresh, Mode=OneWay}" Style="{StaticResource ToolbarButtonStyle}" ToolTipService.ToolTip="刷新区域组">
                <SymbolIcon Symbol="Refresh" />
            </Button>
            <Button Grid.Column="2" AutomationProperties.Name="导入规则" Click="ImportRules_Click" IsEnabled="{x:Bind ViewModel.CanRunFileOperation, Mode=OneWay}" Style="{StaticResource ToolbarButtonStyle}">
                <TextBlock Text="导入规则" />
            </Button>
            <Button Grid.Column="3" AutomationProperties.Name="导出规则" Click="ExportRules_Click" IsEnabled="{x:Bind ViewModel.CanRunFileOperation, Mode=OneWay}" Style="{StaticResource ToolbarButtonStyle}">
                <TextBlock Text="导出规则" />
            </Button>
            <Button Grid.Column="4" AutomationProperties.Name="新建区域组" Command="{x:Bind ViewModel.NewGroupCommand}" IsEnabled="{x:Bind ViewModel.CanNewGroup, Mode=OneWay}" Style="{StaticResource PrimaryToolbarButtonStyle}">
                <TextBlock Text="新建区域组" />
            </Button>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="144" MinWidth="132" />
                <ColumnDefinition Width="*" MinWidth="0" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Padding="14" Style="{StaticResource WorkbenchCardStyle}">
                <Grid>
                    <ListView
                        x:Name="GroupList"
                        ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedGroup, Mode=OneWay}"
                        SelectionChanged="GroupList_SelectionChanged"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:GroupSummaryRow">
                                <StackPanel Padding="4,8" Spacing="3">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind StateLabel}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Border Padding="16" Visibility="{x:Bind ViewModel.GroupListEmptyVisibility, Mode=OneWay}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                            <TextBlock HorizontalAlignment="Center" Text="暂无区域组" />
                        </StackPanel>
                    </Border>
                    <Border Padding="16" Visibility="{x:Bind ViewModel.GroupListErrorVisibility, Mode=OneWay}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                            <TextBlock HorizontalAlignment="Center" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Text="区域组读取失败" />
                            <TextBlock HorizontalAlignment="Center" Text="{x:Bind ViewModel.LoadError, Mode=OneWay}" TextWrapping="Wrap" />
                            <Button AutomationProperties.Name="重试读取区域组" Command="{x:Bind ViewModel.RefreshCommand}" Content="重试" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <ScrollViewer
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                HorizontalScrollBarVisibility="Auto"
                HorizontalScrollMode="Enabled"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Enabled">
                <Border Padding="16" HorizontalAlignment="Stretch" Style="{StaticResource WorkbenchCardStyle}" Visibility="{x:Bind ViewModel.RuleEditorVisibility, Mode=OneWay}">
                    <StackPanel HorizontalAlignment="Stretch" Spacing="10">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="{x:Bind ViewModel.GroupEditorTitle, Mode=OneWay}" />
                            <Button
                                Grid.Column="1"
                                AutomationProperties.Name="查看区域组设备"
                                Click="OpenInData_Click"
                                IsEnabled="{x:Bind ViewModel.CanOpenSelectedInData, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.OpenDataHint, Mode=OneWay}">
                                <TextBlock Text="查看设备" />
                            </Button>
                            <Button
                                Grid.Column="2"
                                AutomationProperties.Name="取消新建区域组"
                                Command="{x:Bind ViewModel.CancelNewGroupCommand}"
                                Content="取消新建"
                                Visibility="{x:Bind ViewModel.NewGroupCancelVisibility, Mode=OneWay}" />
                            <Button Grid.Column="3" AutomationProperties.Name="删除区域组" Click="DeleteGroup_Click" IsEnabled="{x:Bind ViewModel.CanDeleteSelectedGroup, Mode=OneWay}">
                                <TextBlock Text="删除区域组" />
                            </Button>
                        </Grid>

                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource EditorFieldHeaderStyle}" Text="区域组名" />
                            <TextBox IsEnabled="{x:Bind ViewModel.CanEditSelectedGroup, Mode=OneWay}" Text="{x:Bind ViewModel.EditName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <Grid x:Name="GroupSettingsRow" RowSpacing="8" HorizontalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Spacing="4">
                                <TextBlock Style="{StaticResource EditorFieldHeaderStyle}" Text="备注" />
                                <TextBox IsEnabled="{x:Bind ViewModel.CanEditSelectedGroup, Mode=OneWay}" Text="{x:Bind ViewModel.EditNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel
                                x:Name="GroupSettingsActions"
                                Grid.Row="1"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Spacing="12">
                                <CheckBox
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="启用区域组"
                                    Content="启用区域组"
                                    IsEnabled="{x:Bind ViewModel.CanEditSelectedGroup, Mode=OneWay}"
                                    IsChecked="{x:Bind ViewModel.EditEnabled, Mode=TwoWay}" />
                                <Button
                                    AutomationProperties.Name="保存区域组设置"
                                    Command="{x:Bind ViewModel.SaveGroupCommand}"
                                    Style="{StaticResource EditorActionButtonStyle}"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}">
                                    <TextBlock Text="保存区域组" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.RulesEditorVisibility, Mode=OneWay}">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="区域组规则" />
                                <Button Grid.Column="1" AutomationProperties.Name="添加规则" Command="{x:Bind ViewModel.BeginAddRuleCommand}" IsEnabled="{x:Bind ViewModel.CanBeginAddRule, Mode=OneWay}" Style="{StaticResource EditorActionButtonStyle}" Background="Transparent" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                    <TextBlock Text="添加规则" />
                                </Button>
                            </Grid>
                            <TextBlock Text="单条规则为 AND，同组规则为 OR；不含规则负责排除" />
                            <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}" Text="{x:Bind ViewModel.RuleOptionsError, Mode=OneWay}" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.RuleOptionsErrorVisibility, Mode=OneWay}" />

                            <TextBlock Text="暂无规则" Visibility="{x:Bind ViewModel.RulesEmptyVisibility, Mode=OneWay}" />
                            <Grid ColumnSpacing="8" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" MinWidth="32" />
                                    <ColumnDefinition Width="80" MinWidth="72" />
                                    <ColumnDefinition Width="56" MinWidth="48" />
                                    <ColumnDefinition Width="64" MinWidth="56" />
                                    <ColumnDefinition Width="80" MinWidth="72" />
                                    <ColumnDefinition Width="2*" MinWidth="132" />
                                    <ColumnDefinition Width="36" MinWidth="32" />
                                </Grid.ColumnDefinitions>
                                <TextBlock HorizontalAlignment="Stretch" TextAlignment="Center" FontWeight="SemiBold" Text="序号" />
                                <TextBlock Grid.Column="1" HorizontalAlignment="Stretch" TextAlignment="Center" FontWeight="SemiBold" Text="楼栋" />
                                <TextBlock Grid.Column="2" HorizontalAlignment="Stretch" TextAlignment="Center" FontWeight="SemiBold" Text="座号" />
                                <TextBlock Grid.Column="3" HorizontalAlignment="Stretch" TextAlignment="Center" FontWeight="SemiBold" Text="楼层" />
                                <TextBlock Grid.Column="4" HorizontalAlignment="Stretch" TextAlignment="Center" FontWeight="SemiBold" Text="匹配" />
                                <TextBlock Grid.Column="5" HorizontalAlignment="Stretch" FontWeight="SemiBold" Text="关键词" />
                                <TextBlock Grid.Column="6" HorizontalAlignment="Stretch" TextAlignment="Center" FontWeight="SemiBold" Text="操作" />
                            </Grid>
                            <ListView HorizontalContentAlignment="Stretch" ItemsSource="{x:Bind ViewModel.Rules, Mode=OneWay}" Padding="0">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="MinHeight" Value="0" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AreaGroupRuleRow">
                                        <ContentControl Padding="0,4" HorizontalContentAlignment="Stretch" IsEnabled="{Binding ViewModel.CanEditSelectedGroup, ElementName=RootPage}">
                                            <Grid x:Name="RuleEditorRow" ColumnSpacing="8" HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36" MinWidth="32" />
                                                <ColumnDefinition Width="80" MinWidth="72" />
                                                <ColumnDefinition Width="56" MinWidth="48" />
                                                <ColumnDefinition Width="64" MinWidth="56" />
                                                <ColumnDefinition Width="80" MinWidth="72" />
                                                <ColumnDefinition Width="2*" MinWidth="132" />
                                                <ColumnDefinition Width="36" MinWidth="32" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock HorizontalAlignment="Stretch" TextAlignment="Center" VerticalAlignment="Center" Text="{x:Bind RuleOrder}" />
                                            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ItemsSource="{x:Bind BuildingOptions, Mode=OneWay}" SelectedItem="{x:Bind Building, Mode=TwoWay}" SelectionChanged="RuleRowBuilding_SelectionChanged" />
                                            <ComboBox Grid.Column="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ItemsSource="{x:Bind ZuoOptions, Mode=OneWay}" SelectedItem="{x:Bind Zuo, Mode=TwoWay}" />
                                            <ComboBox Grid.Column="3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ItemsSource="{x:Bind FloorOptions, Mode=OneWay}" SelectedItem="{x:Bind Floor, Mode=TwoWay}" />
                                            <ComboBox Grid.Column="4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ItemsSource="{x:Bind MatchModeOptions, Mode=OneWay}" SelectedItem="{x:Bind MatchMode, Mode=TwoWay}" />
                                            <Grid Grid.Column="5" ColumnSpacing="6" HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" MinWidth="0" />
                                                    <ColumnDefinition Width="92" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Height="36" MinWidth="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" PlaceholderText="关键词，用 | 分隔" Text="{x:Bind Keywords, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTipService.ToolTip="{x:Bind Keywords}" />
                                                <TextBlock Grid.Column="1" Width="92" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="NoWrap" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind MatchCountText, Mode=OneWay}" />
                                            </Grid>
                                            <Button Grid.Column="6" Width="36" HorizontalAlignment="Center" HorizontalContentAlignment="Center" AutomationProperties.Name="删除规则" Click="DeleteRuleRow_Click" Content="×" IsEnabled="{Binding ViewModel.CanEditSelectedGroup, ElementName=RootPage, Mode=OneWay}" ToolTipService.ToolTip="删除规则" />
                                            </Grid>
                                        </ContentControl>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <Border
                Grid.ColumnSpan="2"
                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                Padding="24"
                Visibility="{x:Bind ViewModel.LoadingStateVisibility, Mode=OneWay}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <ProgressRing Width="32" Height="32" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                    <TextBlock HorizontalAlignment="Center" Text="正在读取区域组" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
