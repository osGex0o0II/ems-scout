<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Name="AuditRoot"
    x:Class="EmsScout.Desktop.Pages.AuditPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="Page_Loaded"
    mc:Ignorable="d">
    <Grid Padding="{StaticResource PagePadding}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="3">
                <TextBlock Style="{StaticResource WorkbenchPageTitleStyle}" Text="审计中心" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
            </StackPanel>
            <Button Grid.Column="1" AutomationProperties.Name="刷新审计中心" Command="{x:Bind ViewModel.RefreshCommand}" Style="{StaticResource PrimaryToolbarButtonStyle}">
                <FontIcon FontSize="14" Glyph="&#xE72C;" />
            </Button>
        </Grid>

        <Pivot x:Name="WorkspacePivot" Grid.Row="1" SelectedIndex="0">
            <PivotItem Header="历史批次">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.RunsStatusText, Mode=OneWay}" />
                    <Border Grid.Row="1" Padding="16" Style="{StaticResource WorkbenchCardStyle}">
                        <ListView ItemsSource="{x:Bind ViewModel.FilteredRuns, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedRun, Mode=TwoWay}" SelectionMode="Single">
                            <ListView.Header>
                                <Grid Padding="0,0,0,8" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.25*" />
                                        <ColumnDefinition Width="0.9*" />
                                        <ColumnDefinition Width="1.15*" />
                                        <ColumnDefinition Width="0.8*" />
                                        <ColumnDefinition Width="0.9*" />
                                        <ColumnDefinition Width="0.8*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontWeight="SemiBold" Text="完成时间" />
                                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="用时" />
                                    <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="范围" />
                                    <TextBlock Grid.Column="3" FontWeight="SemiBold" Text="卡片数量" />
                                    <TextBlock Grid.Column="4" FontWeight="SemiBold" Text="采集模式" />
                                    <TextBlock Grid.Column="5" FontWeight="SemiBold" Text="版本" />
                                    <TextBlock Grid.Column="6" FontWeight="SemiBold" Text="操作" />
                                </Grid>
                            </ListView.Header>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,8" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.25*" />
                                            <ColumnDefinition Width="0.9*" />
                                            <ColumnDefinition Width="1.15*" />
                                            <ColumnDefinition Width="0.8*" />
                                            <ColumnDefinition Width="0.9*" />
                                            <ColumnDefinition Width="0.8*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding CompletedAt}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding DurationLabel}" />
                                        <TextBlock Grid.Column="2" Text="{Binding ScopeLabel}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Text="{Binding CountLabel}" />
                                        <TextBlock Grid.Column="4" Text="{Binding CollectionModeLabel}" />
                                        <TextBlock Grid.Column="5" Text="{Binding VersionLabel}" />
                                        <Button Grid.Column="6" Click="DeleteRun_Click" Style="{StaticResource ToolbarButtonStyle}" AutomationProperties.Name="删除批次">
                                            <FontIcon Glyph="&#xE74D;" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </Grid>
            </PivotItem>

            <PivotItem Header="采集问题">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="批次" />
                        <ComboBox Grid.Column="1" ItemsSource="{x:Bind ViewModel.FilteredRuns, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedRun, Mode=TwoWay}" DisplayMemberPath="Summary" />
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="点击问题类型查看全部明细记录" />
                    </Grid>
                    <Grid Grid.Row="1">
                        <ListView ItemsSource="{x:Bind ViewModel.IssueCategories, Mode=OneWay}" SelectionMode="Single" SelectionChanged="IssueCategory_SelectionChanged">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid MaximumRowsOrColumns="3" Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border MinWidth="220" Margin="0,0,12,12" Padding="16" Style="{StaticResource MetricCardStyle}">
                                        <StackPanel Spacing="6">
                                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Label}" />
                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Severity}" />
                                            <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding CountText}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </PivotItem>

            <PivotItem Header="问题详情">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{x:Bind ViewModel.FilteredRuns, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedRun, Mode=TwoWay}" DisplayMemberPath="Summary" />
                        <ComboBox Grid.Column="1" ItemsSource="{x:Bind ViewModel.IssueSeverityOptions, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedIssueSeverity, Mode=TwoWay}" />
                        <ComboBox Grid.Column="2" ItemsSource="{x:Bind ViewModel.IssueBuildingOptions, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedIssueBuilding, Mode=TwoWay}" />
                        <TextBox Grid.Column="3" PlaceholderText="搜索楼层、页名、设备或问题依据" Text="{x:Bind ViewModel.IssueSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="4" Click="ShowIssues_Click" Style="{StaticResource ToolbarButtonStyle}" Content="问题类型" />
                        <Button Grid.Column="5" Command="{x:Bind ViewModel.ClearIssueFilterCommand}" Style="{StaticResource ToolbarButtonStyle}" Content="清除筛选" />
                    </Grid>
                    <Border Grid.Row="1" Padding="12" Style="{StaticResource WorkbenchCardStyle}">
                        <ListView ItemsSource="{x:Bind ViewModel.IssueRecords, Mode=OneWay}">
                            <ListView.Header>
                                <Grid Padding="0,0,0,8" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0.8*" />
                                        <ColumnDefinition Width="0.7*" />
                                        <ColumnDefinition Width="0.8*" />
                                        <ColumnDefinition Width="0.8*" />
                                        <ColumnDefinition Width="1.3*" />
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="1.6*" />
                                        <ColumnDefinition Width="1.7*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontWeight="SemiBold" Text="问题" />
                                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="级别" />
                                    <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="楼栋" />
                                    <TextBlock Grid.Column="3" FontWeight="SemiBold" Text="楼层" />
                                    <TextBlock Grid.Column="4" FontWeight="SemiBold" Text="页 / 区域" />
                                    <TextBlock Grid.Column="5" FontWeight="SemiBold" Text="设备" />
                                    <TextBlock Grid.Column="6" FontWeight="SemiBold" Text="页面现象 / 证据" />
                                    <TextBlock Grid.Column="7" FontWeight="SemiBold" Text="采集判断 / 原因" />
                                </Grid>
                            </ListView.Header>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,7" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.8*" />
                                            <ColumnDefinition Width="0.7*" />
                                            <ColumnDefinition Width="0.8*" />
                                            <ColumnDefinition Width="0.8*" />
                                            <ColumnDefinition Width="1.3*" />
                                            <ColumnDefinition Width="1.1*" />
                                            <ColumnDefinition Width="1.6*" />
                                            <ColumnDefinition Width="1.7*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding IssueType}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding Severity}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Building}" />
                                        <TextBlock Grid.Column="3" Text="{Binding Floor}" />
                                        <TextBlock Grid.Column="4" Text="{Binding LocationLabel}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="5" Text="{Binding DeviceLabel}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="6" Text="{Binding ObservationLabel}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="7" Text="{Binding DecisionLabel}" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </Grid>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
