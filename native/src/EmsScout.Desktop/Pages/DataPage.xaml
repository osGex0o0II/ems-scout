<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Name="DataRoot"
    x:Class="EmsScout.Desktop.Pages.DataPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="Page_Loaded"
    mc:Ignorable="d">
    <Grid Padding="{StaticResource PagePadding}" RowSpacing="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="3">
                <TextBlock Style="{StaticResource WorkbenchPageTitleStyle}" Text="数据管理" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <Button
                    Width="32"
                    Height="32"
                    AutomationProperties.Name="{x:Bind ViewModel.LatestBatchIndicatorAutomationName, Mode=OneWay}"
                    Click="LatestBatch_Click"
                    HorizontalContentAlignment="Center"
                    IsEnabled="{x:Bind ViewModel.CanRunDataAction, Mode=OneWay}"
                    Padding="0"
                    Style="{StaticResource ToolbarButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.LatestBatchIndicatorToolTip, Mode=OneWay}">
                    <Grid Width="18" Height="18">
                        <Ellipse
                            Width="14"
                            Height="14"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Fill="{ThemeResource SystemFillColorSuccessBrush}"
                            Opacity="{x:Bind ViewModel.LatestBatchIndicatorOpacity, Mode=OneWay}" />
                        <Ellipse
                            Width="14"
                            Height="14"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Fill="{ThemeResource SystemFillColorCautionBrush}"
                            Opacity="{x:Bind ViewModel.HistoricalBatchIndicatorOpacity, Mode=OneWay}" />
                    </Grid>
                </Button>
                <ComboBox
                    Width="320"
                    MaxDropDownHeight="420"
                    AutomationProperties.Name="选择数据批次"
                    VerticalContentAlignment="Center"
                    ItemsSource="{x:Bind ViewModel.DataSources, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedDataSource, Mode=TwoWay}"
                    IsEnabled="{x:Bind ViewModel.CanChangeDataSource, Mode=OneWay}"
                    SelectionChanged="DataSource_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayLabel}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button
                    Width="36"
                    Height="32"
                    AutomationProperties.Name="刷新当前数据"
                    Click="RefreshLatest_Click"
                    HorizontalContentAlignment="Center"
                    IsEnabled="{x:Bind ViewModel.CanRunDataAction, Mode=OneWay}"
                    Padding="0"
                    Style="{StaticResource ToolbarButtonStyle}"
                    ToolTipService.ToolTip="刷新当前数据">
                    <SymbolIcon Symbol="Refresh" />
                </Button>
                <Button
                    Click="Export_Click"
                    Style="{StaticResource PrimaryToolbarButtonStyle}"
                    IsEnabled="{x:Bind ViewModel.CanExport, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE118;" />
                        <TextBlock Text="导出当前筛选 Excel" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource WorkbenchCardStyle}" Padding="12">
            <Grid RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="筛选条件" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="筛选和 Excel 导出使用同一组条件。" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <Button Click="ApplyFilters_Click" Style="{StaticResource PrimaryToolbarButtonStyle}" IsEnabled="{x:Bind ViewModel.CanRunDataAction, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="14" Glyph="&#xE71C;" />
                                <TextBlock Text="筛选" />
                            </StackPanel>
                        </Button>
                        <Button Click="ResetFilters_Click" Style="{StaticResource ToolbarButtonStyle}" IsEnabled="{x:Bind ViewModel.CanRunDataAction, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="14" Glyph="&#xE777;" />
                                <TextBlock Text="重置" />
                            </StackPanel>
                        </Button>
                        <Button Click="Refresh_Click" Style="{StaticResource ToolbarButtonStyle}" IsEnabled="{x:Bind ViewModel.CanRunDataAction, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <SymbolIcon Symbol="Refresh" />
                                <TextBlock Text="刷新" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                    <Grid Grid.Row="1" ColumnSpacing="6" RowSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" MinWidth="96" />
                            <ColumnDefinition Width="1*" MinWidth="96" />
                            <ColumnDefinition Width="1*" MinWidth="96" />
                            <ColumnDefinition Width="1*" MinWidth="96" />
                            <ColumnDefinition Width="1.2*" MinWidth="112" />
                            <ColumnDefinition Width="1.25*" MinWidth="120" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.ColumnSpan="6" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="关注范围" />
                        <ComboBox Grid.Row="1" Grid.ColumnSpan="3" Header="区域组" DisplayMemberPath="DisplayLabel" ItemsSource="{x:Bind ViewModel.AreaGroupOptions, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedAreaGroup, Mode=TwoWay}" />
                        <TextBlock Grid.Row="2" Grid.ColumnSpan="6" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="位置定位" />
                        <ComboBox Grid.Row="3" Header="楼栋" DisplayMemberPath="DisplayLabel" ItemsSource="{x:Bind ViewModel.BuildingOptions, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedBuilding, Mode=TwoWay}" SelectionChanged="BuildingFilter_SelectionChanged" />
                        <ComboBox Grid.Row="3" Grid.Column="1" Header="座号" DisplayMemberPath="DisplayLabel" ItemsSource="{x:Bind ViewModel.ZuoOptions, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedZuo, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanFilterByZuo, Mode=OneWay}" ToolTipService.ToolTip="仅适用于5号、6号楼" />
                        <ComboBox Grid.Row="3" Grid.Column="2" Header="楼层" DisplayMemberPath="DisplayLabel" ItemsSource="{x:Bind ViewModel.FloorOptions, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedFloor, Mode=TwoWay}" SelectionChanged="FloorFilter_SelectionChanged" />
                        <ComboBox Grid.Row="3" Grid.Column="3" Header="页面" DisplayMemberPath="DisplayLabel" ItemsSource="{x:Bind ViewModel.PageNameOptions, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedPageName, Mode=TwoWay}" />
                        <TextBox Grid.Row="3" Grid.Column="4" Grid.ColumnSpan="2" Header="设备名" PlaceholderText="输入设备名" Text="{x:Bind ViewModel.DeviceNameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="4" Grid.ColumnSpan="6" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="状态筛选" />
                        <ComboBox Grid.Row="5" Header="区域" DisplayMemberPath="DisplayLabel" ItemsSource="{x:Bind ViewModel.AreaOptions, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedArea, Mode=TwoWay}" />
                        <ComboBox Grid.Row="5" Grid.Column="1" Header="开关机状态" DisplayMemberPath="DisplayLabel" ItemsSource="{x:Bind ViewModel.CommunicationOptions, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedCommunication, Mode=TwoWay}" />
                        <ComboBox Grid.Row="5" Grid.Column="2" Header="模式" DisplayMemberPath="DisplayLabel" ItemsSource="{x:Bind ViewModel.ModeOptions, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedMode, Mode=TwoWay}" />
                        <ComboBox Grid.Row="5" Grid.Column="3" Header="风速" DisplayMemberPath="DisplayLabel" ItemsSource="{x:Bind ViewModel.FanOptions, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedFan, Mode=TwoWay}" />
                        <ComboBox Grid.Row="5" Grid.Column="4" Header="设置温度(℃)" DisplayMemberPath="DisplayLabel" ItemsSource="{x:Bind ViewModel.SetTemperatureOptions, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedSetTemperature, Mode=TwoWay}" />
                        <ComboBox Grid.Row="5" Grid.Column="5" Header="集控锁定状态" DisplayMemberPath="DisplayLabel" ItemsSource="{x:Bind ViewModel.RealtimeLockOptions, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedRealtimeLock, Mode=TwoWay}" />
                    </Grid>

            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="0" />
            </Grid.ColumnDefinitions>

            <ProgressBar
                Grid.ColumnSpan="2"
                VerticalAlignment="Top"
                IsIndeterminate="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

            <Border Style="{StaticResource WorkbenchCardStyle}" Padding="0">
                <Grid>
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup>
                            <VisualState x:Name="WideDataLayout">
                                <VisualState.StateTriggers>
                                    <AdaptiveTrigger MinWindowWidth="1500" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Target="WideDataList.Visibility" Value="Visible" />
                                    <Setter Target="CompactDataList.Visibility" Value="Collapsed" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Padding="10,6" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.ResultSummary, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                            <Button
                                Click="PreviousPage_Click"
                                Style="{StaticResource ToolbarButtonStyle}"
                                AutomationProperties.Name="上一页"
                                ToolTipService.ToolTip="上一页"
                                IsEnabled="{x:Bind ViewModel.CanMovePrevious, Mode=OneWay}">
                                <FontIcon FontSize="14" Glyph="&#xE72B;" />
                            </Button>
                            <TextBlock
                                MinWidth="82"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.PageSummary, Mode=OneWay}" />
                            <Button
                                Click="NextPage_Click"
                                Style="{StaticResource ToolbarButtonStyle}"
                                AutomationProperties.Name="下一页"
                                ToolTipService.ToolTip="下一页"
                                IsEnabled="{x:Bind ViewModel.CanMoveNext, Mode=OneWay}">
                                <FontIcon FontSize="14" Glyph="&#xE72A;" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <ListView
                        x:Name="CompactDataList"
                        Grid.Row="1"
                        ItemsSource="{x:Bind ViewModel.Devices, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedDevice, Mode=TwoWay}"
                        SelectionChanged="DeviceList_SelectionChanged"
                        HorizontalContentAlignment="Stretch"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        SelectionMode="Single">
                        <ListView.Resources>
                            <Style x:Key="DataTableCellTextStyle" TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                <Setter Property="TextAlignment" Value="Center" />
                                <Setter Property="TextWrapping" Value="NoWrap" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                <Setter Property="FontSize" Value="14" />
                            </Style>
                        </ListView.Resources>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.Header>
                            <Grid Padding="{x:Bind ViewModel.TableHeaderPadding, Mode=OneWay}" ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.75*" />
                                    <ColumnDefinition Width="0.75*" />
                                    <ColumnDefinition Width="0.75*" />
                                    <ColumnDefinition Width="1.05*" />
                                    <ColumnDefinition Width="1.65*" />
                                    <ColumnDefinition Width="0.95*" />
                                    <ColumnDefinition Width="1.25*" />
                                    <ColumnDefinition Width="0.9*" />
                                    <ColumnDefinition Width="0.7*" />
                                    <ColumnDefinition Width="1.55*" />
                                    <ColumnDefinition Width="1.45*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource DataTableCellTextStyle}" FontWeight="SemiBold" Text="楼栋" />
                                <TextBlock Style="{StaticResource DataTableCellTextStyle}" Grid.Column="1" FontWeight="SemiBold" Text="座号" />
                                <TextBlock Style="{StaticResource DataTableCellTextStyle}" Grid.Column="2" FontWeight="SemiBold" Text="楼层" />
                                <TextBlock Style="{StaticResource DataTableCellTextStyle}" Grid.Column="3" FontWeight="SemiBold" Text="页面" />
                                <TextBlock Style="{StaticResource DataTableCellTextStyle}" Grid.Column="4" FontWeight="SemiBold" Text="设备名" />
                                <TextBlock Style="{StaticResource DataTableCellTextStyle}" Grid.Column="5" FontWeight="SemiBold" Text="区域" />
                                <TextBlock Style="{StaticResource DataTableCellTextStyle}" Grid.Column="6" FontWeight="SemiBold" Text="开关机状态" />
                                <TextBlock Style="{StaticResource DataTableCellTextStyle}" Grid.Column="7" FontWeight="SemiBold" Text="模式" />
                                <TextBlock Style="{StaticResource DataTableCellTextStyle}" Grid.Column="8" FontWeight="SemiBold" Text="风速" />
                                <TextBlock Style="{StaticResource DataTableCellTextStyle}" Grid.Column="9" FontWeight="SemiBold" Text="温度（设 / 环，℃）" />
                                <TextBlock Style="{StaticResource DataTableCellTextStyle}" Grid.Column="10" FontWeight="SemiBold" Text="集控锁定状态" />
                            </Grid>
                        </ListView.Header>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="{Binding DataContext.TableRowPadding, ElementName=DataRoot}" ColumnSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0.75*" />
                                        <ColumnDefinition Width="0.75*" />
                                        <ColumnDefinition Width="0.75*" />
                                        <ColumnDefinition Width="1.05*" />
                                        <ColumnDefinition Width="1.65*" />
                                        <ColumnDefinition Width="0.95*" />
                                        <ColumnDefinition Width="1.25*" />
                                        <ColumnDefinition Width="0.9*" />
                                        <ColumnDefinition Width="0.7*" />
                                        <ColumnDefinition Width="1.55*" />
                                        <ColumnDefinition Width="1.45*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource DataTableCellTextStyle}" Text="{Binding Building}" ToolTipService.ToolTip="{Binding Building}" />
                                    <TextBlock Style="{StaticResource DataTableCellTextStyle}" Grid.Column="1" Text="{Binding Zuo}" ToolTipService.ToolTip="{Binding Zuo}" />
                                    <TextBlock Style="{StaticResource DataTableCellTextStyle}" Grid.Column="2" Text="{Binding FloorLabel}" ToolTipService.ToolTip="{Binding FloorLabel}" />
                                    <TextBlock Style="{StaticResource DataTableCellTextStyle}" Grid.Column="3" Text="{Binding PageName}" ToolTipService.ToolTip="{Binding PageName}" />
                                    <TextBlock Style="{StaticResource DataTableCellTextStyle}" Grid.Column="4" FontWeight="SemiBold" Text="{Binding Name}" ToolTipService.ToolTip="{Binding Name}" />
                                    <TextBlock Style="{StaticResource DataTableCellTextStyle}" Grid.Column="5" Text="{Binding AreaType}" ToolTipService.ToolTip="{Binding AreaType}" />
                                    <TextBlock Style="{StaticResource DataTableCellTextStyle}" Grid.Column="6" Foreground="{Binding CommunicationForeground}" Text="{Binding CommunicationText}" ToolTipService.ToolTip="{Binding CommunicationText}" />
                                    <TextBlock Style="{StaticResource DataTableCellTextStyle}" Grid.Column="7" Text="{Binding Mode}" ToolTipService.ToolTip="{Binding Mode}" />
                                    <TextBlock Style="{StaticResource DataTableCellTextStyle}" Grid.Column="8" Text="{Binding Fan}" ToolTipService.ToolTip="{Binding Fan}" />
                                    <StackPanel Grid.Column="9" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="2" ToolTipService.ToolTip="设置温度 / 环境温度">
                                        <TextBlock Style="{StaticResource DataTableCellTextStyle}" FontWeight="SemiBold" Foreground="{Binding TemperatureForeground}" Text="{Binding SetTemperatureValue}" />
                                        <TextBlock Style="{StaticResource DataTableCellTextStyle}" Text=" / " />
                                        <TextBlock Style="{StaticResource DataTableCellTextStyle}" FontWeight="SemiBold" Foreground="{Binding TemperatureForeground}" Text="{Binding IndoorTemperatureValue}" />
                                        <TextBlock Style="{StaticResource DataTableCellTextStyle}" Text=" ℃" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource DataTableCellTextStyle}" Grid.Column="10" Text="{Binding RealtimeLock}" ToolTipService.ToolTip="{Binding RealtimeLock}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <ListView
                        x:Name="WideDataList"
                        Grid.Row="1"
                        Visibility="Collapsed"
                        ItemsSource="{x:Bind ViewModel.Devices, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedDevice, Mode=TwoWay}"
                        SelectionChanged="DeviceList_SelectionChanged"
                        HorizontalContentAlignment="Stretch"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        SelectionMode="Single">
                        <ListView.Resources>
                            <Style x:Key="DataTableCellTextStyle" TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                <Setter Property="TextAlignment" Value="Center" />
                                <Setter Property="TextWrapping" Value="NoWrap" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                <Setter Property="FontSize" Value="14" />
                            </Style>
                        </ListView.Resources>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.Header>
                            <Grid Padding="{x:Bind ViewModel.TableHeaderPadding, Mode=OneWay}" ColumnSpacing="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.75*" />
                                    <ColumnDefinition Width="0.75*" />
                                    <ColumnDefinition Width="0.75*" />
                                    <ColumnDefinition Width="1.05*" />
                                    <ColumnDefinition Width="1.65*" />
                                    <ColumnDefinition Width="0.95*" />
                                    <ColumnDefinition Width="1.25*" />
                                    <ColumnDefinition Width="0.9*" />
                                    <ColumnDefinition Width="0.7*" />
                                    <ColumnDefinition Width="1.55*" />
                                    <ColumnDefinition Width="1.45*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource DataTableCellTextStyle}" FontWeight="SemiBold" Text="楼栋" />
                                <TextBlock Style="{StaticResource DataTableCellTextStyle}" Grid.Column="1" FontWeight="SemiBold" Text="座号" />
                                <TextBlock Style="{StaticResource DataTableCellTextStyle}" Grid.Column="2" FontWeight="SemiBold" Text="楼层" />
                                <TextBlock Style="{StaticResource DataTableCellTextStyle}" Grid.Column="3" FontWeight="SemiBold" Text="页面" />
                                <TextBlock Style="{StaticResource DataTableCellTextStyle}" Grid.Column="4" FontWeight="SemiBold" Text="设备名" />
                                <TextBlock Style="{StaticResource DataTableCellTextStyle}" Grid.Column="5" FontWeight="SemiBold" Text="区域" />
                                <TextBlock Style="{StaticResource DataTableCellTextStyle}" Grid.Column="6" FontWeight="SemiBold" Text="开关机状态" />
                                <TextBlock Style="{StaticResource DataTableCellTextStyle}" Grid.Column="7" FontWeight="SemiBold" Text="模式" />
                                <TextBlock Style="{StaticResource DataTableCellTextStyle}" Grid.Column="8" FontWeight="SemiBold" Text="风速" />
                                <TextBlock Style="{StaticResource DataTableCellTextStyle}" Grid.Column="9" FontWeight="SemiBold" Text="温度（设 / 环，℃）" />
                                <TextBlock Style="{StaticResource DataTableCellTextStyle}" Grid.Column="10" FontWeight="SemiBold" Text="集控锁定状态" />
                            </Grid>
                        </ListView.Header>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="{Binding DataContext.TableRowPadding, ElementName=DataRoot}" ColumnSpacing="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0.75*" />
                                        <ColumnDefinition Width="0.75*" />
                                        <ColumnDefinition Width="0.75*" />
                                        <ColumnDefinition Width="1.05*" />
                                        <ColumnDefinition Width="1.65*" />
                                        <ColumnDefinition Width="0.95*" />
                                        <ColumnDefinition Width="1.25*" />
                                        <ColumnDefinition Width="0.9*" />
                                        <ColumnDefinition Width="0.7*" />
                                        <ColumnDefinition Width="1.55*" />
                                        <ColumnDefinition Width="1.45*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource DataTableCellTextStyle}" Text="{Binding Building}" ToolTipService.ToolTip="{Binding Building}" />
                                    <TextBlock Style="{StaticResource DataTableCellTextStyle}" Grid.Column="1" Text="{Binding Zuo}" ToolTipService.ToolTip="{Binding Zuo}" />
                                    <TextBlock Style="{StaticResource DataTableCellTextStyle}" Grid.Column="2" Text="{Binding FloorLabel}" ToolTipService.ToolTip="{Binding FloorLabel}" />
                                    <TextBlock Style="{StaticResource DataTableCellTextStyle}" Grid.Column="3" Text="{Binding PageName}" ToolTipService.ToolTip="{Binding PageName}" />
                                    <TextBlock Style="{StaticResource DataTableCellTextStyle}" Grid.Column="4" FontWeight="SemiBold" Text="{Binding Name}" ToolTipService.ToolTip="{Binding Name}" />
                                    <TextBlock Style="{StaticResource DataTableCellTextStyle}" Grid.Column="5" Text="{Binding AreaType}" ToolTipService.ToolTip="{Binding AreaType}" />
                                    <TextBlock Style="{StaticResource DataTableCellTextStyle}" Grid.Column="6" Foreground="{Binding CommunicationForeground}" Text="{Binding CommunicationText}" ToolTipService.ToolTip="{Binding CommunicationText}" />
                                    <TextBlock Style="{StaticResource DataTableCellTextStyle}" Grid.Column="7" Text="{Binding Mode}" ToolTipService.ToolTip="{Binding Mode}" />
                                    <TextBlock Style="{StaticResource DataTableCellTextStyle}" Grid.Column="8" Text="{Binding Fan}" ToolTipService.ToolTip="{Binding Fan}" />
                                    <StackPanel Grid.Column="9" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="2" ToolTipService.ToolTip="设置温度 / 环境温度">
                                        <TextBlock Style="{StaticResource DataTableCellTextStyle}" FontWeight="SemiBold" Foreground="{Binding TemperatureForeground}" Text="{Binding SetTemperatureValue}" />
                                        <TextBlock Style="{StaticResource DataTableCellTextStyle}" Text=" / " />
                                        <TextBlock Style="{StaticResource DataTableCellTextStyle}" FontWeight="SemiBold" Foreground="{Binding TemperatureForeground}" Text="{Binding IndoorTemperatureValue}" />
                                        <TextBlock Style="{StaticResource DataTableCellTextStyle}" Text=" ℃" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource DataTableCellTextStyle}" Grid.Column="10" Text="{Binding RealtimeLock}" ToolTipService.ToolTip="{Binding RealtimeLock}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel
                        Grid.RowSpan="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="6"
                        Visibility="{x:Bind ViewModel.EmptyStateVisibility, Mode=OneWay}">
                        <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="没有符合条件的设备" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="调整筛选条件后重新查询。"
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>
                    <Border
                        Grid.RowSpan="2"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        Opacity="0.96"
                        Visibility="{x:Bind ViewModel.LoadingStateVisibility, Mode=OneWay}">
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="10">
                            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                            <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="正在查询 SQLite 数据" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="筛选结果和 Excel 导出会使用同一组条件。"
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</Page>
